{
  "name": "caxe",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "api:dev": "wrangler dev --config api/wrangler.jsonc",
    "api:check": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config api/wrangler.jsonc",
    "db:generate": "drizzle-kit generate --config api/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config api/drizzle.config.ts",
    "web:build": "expo export --platform web --output-dir dist/web",
    "web:preview": "node scripts/preview.mjs",
    "format": "prettier --write src api/src tests scripts plugins *.json *.ts *.cjs",
    "native:bundle": "expo export --platform ios --platform android --output-dir dist/native"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.18",
    "@expo-google-fonts/inter": "^0.4.2",
    "@neondatabase/serverless": "^1.0.2",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.0",
    "expo-crypto": "~58.0.0",
    "expo-dev-client": "~58.0.0",
    "expo-font": "~58.0.0",
    "expo-image": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-modules-core": "~58.0.0",
    "expo-network": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "hono": "^4.10.0",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "drizzle-kit": "^0.31.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "wrangler": "^4.45.0"
  },
  "type": "module"
}
